<Project Sdk="WixToolset.Sdk/5.0.2">
    <PropertyGroup>
        <OutputType>Bundle</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    </ItemGroup>

    <PropertyGroup>
		<Gekka_SignTool_Algorithms >SHA1;SHA256;</Gekka_SignTool_Algorithms>
    </PropertyGroup>
	<Target Name="AA1" BeforeTargets="Build">
		<Message Text="あああああああああああああああああああああああああああああああああああああああああああああ"/>
		<Message Text="$(Gekka_SignTool_Algorithms)"/>
	</Target>
	<Target Name="AA2" AfterTargets="Build">
		<Message Text="いいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいいい"/>
		<Message Text="$(Gekka_SignTool_Algorithms)"/>
	</Target>
</Project>